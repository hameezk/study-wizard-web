{
  "name": "studywizard-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "npm run guard:secrets && npm run guard:copy && next build",
    "start": "next start -p 3001",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "guard:secrets": "node scripts/guard-secrets.mjs",
    "guard:copy": "node scripts/guard-copy.mjs",
    "webhook:paid": "node --env-file=.env scripts/simulate-webhook.mjs paid",
    "webhook:refund": "node --env-file=.env scripts/simulate-webhook.mjs refund"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@supabase/supabase-js": "^2.58.0",
    "@supabase/ssr": "^0.7.0",
    "stripe": "^18.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
