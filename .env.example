# ─────────────────────────────────────────────────────────────────────────────
# studywizard-web — marketing, auth, payments
# NEXT_PUBLIC_* is inlined into the browser bundle. Put nothing secret there.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3001
HOSTNAME=127.0.0.1

# ── Public ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://studywizard.com
NEXT_PUBLIC_APP_URL=https://dashboard.studywizard.com
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# Publishable key only. Anything in a NEXT_PUBLIC_ var is inlined into the
# browser bundle, so the secret key must never appear here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_
NEXT_PUBLIC_CHROME_WEB_STORE_URL=
NEXT_PUBLIC_DISCORD_INVITE_URL=

# ── Server only ─────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_
# Bypasses RLS. Used only by the Stripe webhook route, which must write access
# grants for a user who is not the caller.
SUPABASE_SECRET_KEY=sb_secret_
SESSION_COOKIE_DOMAIN=.studywizard.com

STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_RESTRICTED_KEY=rk_test_

# Driver: 'smtp' (default — Hostinger mail) or 'resend'. Must match the app's
# setting, or receipts and verification mails come from two different senders.
EMAIL_DRIVER=smtp
EMAIL_FROM="Study Wizard <noreply@studywizard.com>"
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=

# Ping the app's sweeper after fulfilment so queued email drains promptly
INTERNAL_API_SECRET=
APP_INTERNAL_URL=http://127.0.0.1:3002

# ── Analytics (optional) ────────────────────────────────────────────────────
NEXT_PUBLIC_GTM_ID=
SGTM_EVENTS_URL=
SGTM_EVENTS_SECRET=
